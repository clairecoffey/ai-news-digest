# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# .env is listed in .gitignore and must never be committed.

# ---- Email (required) -------------------------------------------------------

# Resend API key, from https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Address the digest is sent FROM. Resend gives you onboarding@resend.dev for testing;
# to send from your own domain you have to verify it with them first.
FROM_EMAIL=digest@yourdomain.com

# Address the digest is sent TO — where you want to read it each morning.
TO_EMAIL=you@example.com

# ---- Selection (optional, these are the defaults) ---------------------------

# Minimum score out of 10 for a story to be included.
MIN_SCORE=7

# How many stories to include, top N by score. A strand with nothing in the top N
# still gets its best story if that story scores 6 or more.
TOP_N=12

# Name shown in the email heading and subject line.
DIGEST_TITLE=AI & Science Daily

# ---- Scoring (optional) -----------------------------------------------------

# Scoring runs through the local `claude` CLI in headless mode, which uses your
# logged-in Claude subscription. There is no API key to set here: install Claude Code
# and run `claude` once to log in.

# Model alias passed to `claude --model`.
CLAUDE_MODEL=sonnet

# Path to the Claude Code CLI, if `claude` is not on your PATH.
CLAUDE_BIN=claude

# Path to the rubric file, if you keep it somewhere other than ./rubric.md
RUBRIC_PATH=rubric.md
